# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# Sub2API SSO. Use the same secret as Sub2API OPEN_WEBUI_REDEEM_SECRET.
SUB2API_SSO_ENABLED=true
SUB2API_BASE_URL='http://127.0.0.1:62080'
SUB2API_REDEEM_SECRET=''
# Optional overrides:
# SUB2API_REDEEM_URL='http://127.0.0.1:62080/api/v1/internal/open-webui/redeem'
# SUB2API_LAUNCH_URL='http://127.0.0.1:62080/open-webui/launch'

# Required for image generation UI when using Sub2API /v1/images/generations.
ENABLE_IMAGE_GENERATION=true
IMAGE_GENERATION_ENGINE='openai'

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
